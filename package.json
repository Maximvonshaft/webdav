{
  "name": "cls-cn-crawler",
  "version": "1.0.0",
  "description": "基于 Crawlee + Playwright + Stealth + 代理池 + GPT-4o + BeautifulSoup4 的 cls.cn 智能爬虫示例",
  "type": "module",
  "scripts": {
    "prepare": "playwright install chromium",
    "dev": "tsx src/index.ts",
    "crawl": "NODE_ENV=production tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "crawlee",
    "playwright",
    "stealth",
    "proxy",
    "openai",
    "beautifulsoup4",
    "cls.cn"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@crawlee/playwright": "^3.7.4",
    "crawlee": "^3.7.4",
    "dotenv": "^16.4.5",
    "openai": "^4.77.0",
    "pino": "^9.4.0",
    "playwright": "^1.49.1",
    "playwright-extra": "^4.3.6",
    "playwright-extra-plugin-stealth": "^2.11.2",
    "tslib": "^2.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
